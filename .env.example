# Existing Render variables - keep current values and secrets.
DATABASE_URL=postgresql://REPLACE_WITH_RENDER_INTERNAL_DATABASE_URL
MEMORY_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DB_SSLMODE=prefer
PUBLIC_BASE_URL=https://langmind-file-generator-ue2c.onrender.com

# New Quotation AI variables. Keep OPENAI_API_KEY secret on Render.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_VISION_MODEL=gpt-4.1-mini
QUOTATION_MAX_UPLOAD_BYTES=15728640

# Existing file generator settings (optional).
FILE_STORAGE_DIR=/tmp/generated_files
FILE_TTL_SECONDS=86400
MAX_CONTENT_CHARS=200000
